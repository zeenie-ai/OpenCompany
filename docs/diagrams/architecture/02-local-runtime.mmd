flowchart LR
    client["Browser / Electron"]
    cli["company start"]
    subgraph backend["ONE BACKEND PROCESS"]
        api["API + WebSocket + built SPA"]
        services["Application services"]
        workers["Embedded SDK workers"]
        api --> services
        services -->|start and manage| workers
    end
    temporal["Temporal server child"]
    history[("Temporal history SQLite")]
    appdb[("Application database")]
    secrets[("Encrypted credentials")]
    files["Workspaces + packages"]
    sidecars["Lazy sidecars"]
    vite["Vite: development only"]
    docker["Docker: same runtime in one container"]
    client -->|HTTP / WebSocket| api
    cli -->|launch| api
    services -->|submit workflows| temporal
    workers -->|poll / report| temporal
    temporal --> history
    services --> appdb
    services --> secrets
    services --> files
    services -->|on demand| sidecars
    vite -.->|proxy API / WS| api
    docker -.->|hosts| api
