{
  "name": "opencompany-nodejs-executor",
  "version": "1.0.0",
  "description": "Persistent bun-hosted server for JavaScript/TypeScript code execution",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.18",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
