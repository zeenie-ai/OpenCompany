    "sarvam": {
      "_description": "Sarvam non-chat APIs. Text endpoints bill per CHARACTER and speech-to-text bills per SECOND, so these are per-unit prices and the nodes pass the unit count as resource_count. Converted from Sarvam's INR list prices at 1 INR = 0.0113 USD (~88.5 INR/USD, 2026-07): translate 20 INR/10K chars, language ID 3.5 INR/10K chars, TTS bulbul:v3 30 INR/10K chars and bulbul:v2 15 INR/10K chars, speech-to-text 30 INR/hour. Transliteration has no separately published rate and is priced as translation. Chat-model token pricing lives under `llm.sarvam`.",
      "_source": "https://docs.sarvam.ai/api/getting-started/pricing",
      "_updated": "2026-07",
      "translate": 0.0000226,
      "transliterate": 0.0000226,
      "detect_language": 0.00000396,
      "text_to_speech": 0.0000339,
      "text_to_speech_v2": 0.00001695,
      "speech_to_text": 0.00009417,
      "_default": 0.0000226
    },
    "deepl": {
      "_description": "Translation, billed per CHARACTER. DeepL API Pro is $25 per 1M characters on top of a fixed monthly fee, which this per-character figure represents; the API Free tier gives 500K characters/month at no cost, so an install on Free is over-reported. DeepL returns billed_characters per translation and the node reports THAT rather than counting input, so the character count is the provider's own.",
      "_source": "https://www.deepl.com/pro-api",
      "_updated": "2026-07",
      "translate": 0.000025,
      "_default": 0.000025
    },
    "elevenlabs": {
      "_description": "Text-to-speech, billed per CHARACTER of input. VERIFIED against the published API rate card: $0.10 per 1,000 characters for Multilingual v2/v3 (eleven_multilingual_v2 is the default model here) and $0.05 per 1,000 for Flash/Turbo. This table has no per-model axis, so the higher multilingual rate is used — an install running mostly Flash should halve it. Plans include a character quota; overage is charged at these same rates, so this is the marginal cost rather than the average.",
      "_source": "https://elevenlabs.io/pricing/api",
      "_updated": "2026-07",
      "text_to_speech": 0.0001,
      "_default": 0.0001
    },
    "deepgram": {
      "_description": "Speech-to-text, billed per MINUTE of audio. VERIFIED Pay-As-You-Go rate for Nova-3 Monolingual pre-recorded ($0.0077/min); Nova-3 Multilingual is $0.0092/min. The node converts measured seconds to minutes before recording, so resource_count here is minutes, not seconds.",
      "_source": "https://deepgram.com/pricing",
      "_updated": "2026-07",
      "speech_to_text": 0.0077,
      "_default": 0.0077
    },
    "openai": {
      "_description": "OpenAI's /audio/* routes only. These live here rather than under `llm.openai` — the two blocks are separate namespaces and do not collide. speech_to_text bills per SECOND and is accurate: $0.006/minute (gpt-4o-transcribe and whisper-1) = $0.0001/sec; gpt-4o-mini-transcribe is half that. text_to_speech UNDER-REPORTS and cannot fully be fixed in this schema: gpt-4o-mini-tts charges $0.60 per 1M INPUT characters (the figure below) PLUS $12 per 1M audio OUTPUT tokens, which usually dominates — OpenAI's own all-in estimate is ~$0.015/minute of speech. This table bills per character with no output-token axis, so an operator who wants the total reflected should raise text_to_speech to roughly 0.0000167 (that estimate at ~900 characters/minute of speech).",
      "_source": "https://openai.com/api/pricing/",
      "_updated": "2026-07",
      "text_to_speech": 0.0000006,
      "speech_to_text": 0.0001,
      "_default": 0.0001
    },
    "groq": {
      "_description": "Groq transcription only (token pricing lives under `llm.groq`). Billed per SECOND of audio: $0.04/hour for whisper-large-v3-turbo, the default model. Groq bills a 10-second floor per request, which the provider module applies before reporting the count.",
      "_source": "https://groq.com/pricing/",
      "_updated": "2026-07",
      "speech_to_text": 0.0000111,
      "_default": 0.0000111
    }
  },

